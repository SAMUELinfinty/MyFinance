# Server Port & Node Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/myfinance_auth

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=your_super_secret_access_token_key_32bytes_min
JWT_ACCESS_EXPIRY=15m

JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_32bytes_min
JWT_REFRESH_EXPIRY=7d

# Cookie Configuration
COOKIE_SECRET=your_cookie_signer_secret_key

# Email Server Settings (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@myfinance.com

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
